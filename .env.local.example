# ============================================================
# CLICS - Click Fraud Detection Platform
# Copiar este archivo como .env.local y completar los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_NAME=Clics

# --- PostgreSQL (AWS RDS) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clics_db?schema=public"

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# --- Firebase (Auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:xxx:web:xxx"
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Ads API ---
GOOGLE_ADS_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="your-client-secret"
GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3004/api/v1/google-ads/callback"

# --- GeoIP (ip-api.com) ---
# Plan Pro: aumenta límite a 15,000 req/min y agrega campos de VPN/proxy
IPAPI_PRO_KEY=""   # Dejar vacío para usar el tier gratuito (45 req/min)
